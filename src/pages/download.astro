    <script>
      let downloadData = { macos: 0, windows: 0 };

      // Update display with current counts
      function updateDisplay() {
        const macosEl = document.getElementById('macos-count');
        const windowsEl = document.getElementById('windows-count');
        const totalEl = document.getElementById('total-downloads');

        const total = downloadData.macos + downloadData.windows;

        if (macosEl) {
          macosEl.textContent = `${downloadData.macos.toLocaleString()} downloads`;
        }
        if (windowsEl) {
          windowsEl.textContent = `${downloadData.windows.toLocaleString()} downloads`;
        }
        if (totalEl && total > 0) {
          totalEl.textContent = `${total.toLocaleString()} total downloads`;
        }
      }

      // Fetch and display download counts
      async function fetchDownloadCounts() {
        try {
          const response = await fetch('/api/downloads');
          downloadData = await response.json();
          updateDisplay();
        } catch (error) {
          console.error('Failed to fetch download counts:', error);
        }
      }

      // Track download click and update display immediately
      async function trackDownload(platform) {
        // Update locally immediately for instant feedback
        downloadData[platform]++;
        updateDisplay();

        try {
          await fetch(`/api/downloads?platform=${platform}`, {
            method: 'POST'
          });
        } catch (error) {
          console.error('Failed to track download:', error);
          // Revert on error
          downloadData[platform]--;
          updateDisplay();
        }
      }

      // Set up download button click handlers
      document.addEventListener('DOMContentLoaded', () => {
        const macosBtn = document.getElementById('macos-download');
        const windowsBtn = document.getElementById('windows-download');

        macosBtn?.addEventListener('click', () => {
          trackDownload('macos');
        });

        windowsBtn?.addEventListener('click', () => {
          trackDownload('windows');
        });
      });

      fetchDownloadCounts();
    </script>
  </body>
